rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidVisitorCounterPayload(data) {
      return data.keys().hasOnly(['count', 'updatedAt'])
        && data.count is int
        && data.count >= 0
        && data.updatedAt is timestamp;
    }

    match /site_stats/{statId} {
      allow read: if true;
      allow create: if statId == 'visitor_counter'
        && isValidVisitorCounterPayload(request.resource.data);
      allow update: if statId == 'visitor_counter'
        && isValidVisitorCounterPayload(request.resource.data)
        && request.resource.data.count >= resource.data.count;
      allow delete: if false;
    }

    match /changing_channel_movies/{movieId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
